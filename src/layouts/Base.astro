---
import '../styles/global.css';
import site from '../data/site.json';

interface Props { title: string; description: string; path?: string; }
const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'Гидрология',
  description: 'Проектирование, строительство и обслуживание водных объектов: плавательные водоёмы, живые бассейны, декоративные водоёмы, фонтаны.',
  url: 'https://gidrologia.ru/',
  logo: 'https://gidrologia.ru/logo.svg',
  telephone: '+7-812-748-22-44',
  email: site.contacts.email,
  foundingDate: String(site.since),
  areaServed: 'RU',
  address: { '@type': 'PostalAddress', addressLocality: 'Санкт-Петербург', addressCountry: 'RU' },
  openingHours: 'Mo-Fr 10:00-18:00',
  sameAs: [site.links.instagram, site.links.houzz],
};
---
<!doctype html>
<html lang="ru" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#05161D">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content="Гидрология">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta name="yandex-verification" content="fa2640a94956b9c6">
  <meta name="yandex-verification" content="05b55e55ad1d2c39">
  <script is:inline>document.documentElement.classList.remove('no-js');</script>
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
</head>
<body>
