RewriteRule ^forum/viewforum\.php$ /arhiv-foruma/2-plavatelnye-vodoemy/? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)f=28(&|$)
RewriteRule ^forum/viewforum\.php$ /arhiv-foruma/28-kupeli/? [L,R=301]
