# Гидрология — настройки Apache (хостинг Timeweb)

AddDefaultCharset UTF-8
Options -Indexes
# Главная — index.html (заглушка хостинга index.htm не должна перехватывать)
DirectoryIndex index.html index.php

# Единый адрес https://gidrologia.ru: другие домены и www — туда.
# new.gidrologia.ru — предпросмотр до запуска: без переадресации и закрыт от поисковиков.
RewriteEngine On
SetEnvIfNoCase Host ^new\.gidrologia\.ru$ GIDRO_PREVIEW
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=GIDRO_PREVIEW
</IfModule>
# >>> магазин (scripts/inject_shop_redirects.py)
# Старый магазин shop.gidrologia.ru: когда поддомен направлен на этот сайт, его адреса ведут в /magazin/.
RewriteCond %{HTTP_HOST} ^(www\.)?shop\.gidrologia\.ru$ [NC]
RewriteRule ^oplata/?$ https://gidrologia.ru/magazin/oplata/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(www\.)?shop\.gidrologia\.ru$ [NC]
RewriteRule ^dostavka/?$ https://gidrologia.ru/magazin/dostavka/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(www\.)?shop\.gidrologia\.ru$ [NC]
RewriteRule ^guarantee/?$ https://gidrologia.ru/magazin/garantii/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(www\.)?shop\.gidrologia\.ru$ [NC]
RewriteRule ^(netcat_files|images)/ - [L]
RewriteCond %{HTTP_HOST} ^(www\.)?shop\.gidrologia\.ru$ [NC]
RewriteRule !^catalog/ https://gidrologia.ru/magazin/ [L,R=301]
# Старый магазин shop.gidrologia.ru → раздел /magazin/ (создано scripts/import-shop.py)
